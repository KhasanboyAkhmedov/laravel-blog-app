APP_NAME="Blog App"
APP_ENV=local
APP_KEY=base64:SAdD+L+R5Ego/OyGrLbwMjbicgIv2kUvtMTtkuWqPUY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
# DB_HOST must be the docker-compose service name, not 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=blog_db
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
