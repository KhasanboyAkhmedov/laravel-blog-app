APP_NAME="Blog App"
APP_ENV=local
APP_KEY=base64:SAdD+L+R5Ego/OyGrLbwMjbicgIv2kUvtMTtkuWqPUY=
APP_DEBUG=true
APP_URL=http://localhost:8888

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
# "db" = the postgres service name in docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=blog_db
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Tells Laravel where Vite dev server is (for hot reload)
VITE_APP_NAME="${APP_NAME}"
